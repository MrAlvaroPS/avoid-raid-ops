{
  "name": "avoid-raid-ops-vercel",
  "private": true,
  "version": "0.3.9-13-vercel.3",
  "type": "module",
  "workspaces": ["apps/web"],
  "scripts": {
    "predev": "node --env-file=.env.local scripts/simc-docker-sync.mjs --preflight",
    "dev": "vite",
    "sync:simc": "node --env-file=.env.local scripts/simc-docker-sync.mjs --force",
    "status:simc": "node --env-file=.env.local scripts/simc-docker-sync.mjs --status",
    "sync:simc-source-native": "node --env-file=.env.local scripts/simc-source-sync.mjs --force",
    "status:simc-source-native": "node --env-file=.env.local scripts/simc-source-sync.mjs --status",
    "sync:simc-native": "node --env-file=.env.local scripts/simc-nightly-sync.mjs --force --allow-native-nightly",
    "status:simc-native": "node --env-file=.env.local scripts/simc-nightly-sync.mjs --status",
    "sync:home-roster": "node --env-file=.env.local scripts/iris-home-roster-smoke.mjs --refresh",
    "validate:home-roster": "node --env-file=.env.local scripts/iris-home-roster-smoke.mjs",
    "validate:loot-roster": "node --env-file=.env.local scripts/loot-roster-smoke.mjs",
    "validate:loot-catalog": "node --env-file=.env.local scripts/loot-raid-catalog-smoke.mjs",
    "iris": "node --env-file=.env.local scripts/iris-local-worker.mjs",
    "prepare:boss": "node --env-file=.env.local scripts/iris-prepare-boss.mjs",
    "validate:raid-catalog": "node --env-file=.env.local scripts/iris-raid-catalog-smoke.mjs",
    "validate:raid-learning": "node --env-file=.env.local scripts/iris-raid-learning-plan-smoke.mjs",
    "validate:raid-corpus-bootstrap": "node --env-file=.env.local scripts/iris-raid-corpus-bootstrap.mjs",
    "bootstrap:raid-corpus": "node --env-file=.env.local scripts/iris-raid-corpus-bootstrap.mjs --start",
    "work:raid-corpus": "node --env-file=.env.local scripts/iris-raid-corpus-worker.mjs",
    "validate:home-history": "node --env-file=.env.local scripts/iris-home-history-smoke.mjs",
    "validate:official-encounter": "node --env-file=.env.local scripts/iris-official-encounter-smoke.mjs",
    "validate:spell-structure": "node --env-file=.env.local scripts/iris-spell-structure-smoke.mjs",
    "validate:evidence-groups": "node --env-file=.env.local scripts/iris-evidence-groups-smoke.mjs",
    "validate:untouched-holdout": "node --env-file=.env.local scripts/iris-untouched-holdout-smoke.mjs",
    "validate:loot-simc": "node --env-file=.env.local scripts/loot-simc-smoke.mjs",
    "dev:source": "npm --workspace @avoid/web run dev",
    "build:web": "npm --workspace @avoid/web run build",
    "verify:golden": "python3 scripts/verify_golden.py",
    "verify:architecture": "python3 scripts/verify_architecture.py",
    "verify": "npm run verify:golden && npm run verify:architecture && npm run verify:reconstruction && npm run test:critical && npm test",
    "test": "node --test tests/unit/*.test.mjs",
    "test:critical": "node --test tests/critical/*.test.mjs",
    "verify:reconstruction": "python3 scripts/verify_reconstruction.py",
    "verify:data-truth": "python3 scripts/verify_data_truth_ui.py",
    "build": "npm run verify:vercel && npm run test:critical && npm test && vite build",
    "preversion": "npm run verify:vercel && npm run test:critical",
    "preview": "vite preview",
    "verify:vercel": "node scripts/verify-vercel.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.6.1",
    "nitro": "3.0.260610-beta",
    "workflow": "5.0.0-beta.36"
  },
  "devDependencies": {"vite":"npm:rolldown-vite@7.2.5"},
  "overrides": {"vite":"npm:rolldown-vite@7.2.5"},
  "engines": {"node":"22.x"}
}
