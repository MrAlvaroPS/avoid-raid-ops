{
  "name": "avoid-raid-ops-vercel",
  "private": true,
  "version": "0.3.9-10-vercel.0",
  "type": "module",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "vite",
    "iris": "node --env-file=.env.local scripts/iris-local-worker.mjs",
    "validate:raid-catalog": "node --env-file=.env.local scripts/iris-raid-catalog-smoke.mjs",
    "validate:official-encounter": "node --env-file=.env.local scripts/iris-official-encounter-smoke.mjs",
    "validate:spell-structure": "node --env-file=.env.local scripts/iris-spell-structure-smoke.mjs",
    "validate:evidence-groups": "node --env-file=.env.local scripts/iris-evidence-groups-smoke.mjs",
    "validate:untouched-holdout": "node --env-file=.env.local scripts/iris-untouched-holdout-smoke.mjs",
    "dev:source": "npm --workspace @avoid/web run dev",
    "build:web": "npm --workspace @avoid/web run build",
    "verify:golden": "python3 scripts/verify_golden.py",
    "verify:architecture": "python3 scripts/verify_architecture.py",
    "verify": "npm run verify:golden && npm run verify:architecture && npm run verify:reconstruction && npm run test:critical && npm test",
    "test": "node --test tests/unit/*.test.mjs",
    "test:critical": "node --test tests/critical/*.test.mjs",
    "verify:reconstruction": "python3 scripts/verify_reconstruction.py",
    "verify:data-truth": "python3 scripts/verify_data_truth_ui.py",
    "build": "npm run verify:vercel && npm run test:critical && npm test && vite build",
    "preversion": "npm run verify:vercel && npm run test:critical",
    "preview": "vite preview",
    "verify:vercel": "node scripts/verify-vercel.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.6.1",
    "nitro": "3.0.260610-beta",
    "workflow": "5.0.0-beta.36"
  },
  "devDependencies": {"vite":"npm:rolldown-vite@7.2.5"},
  "overrides": {"vite":"npm:rolldown-vite@7.2.5"},
  "engines": {"node":"22.x"}
}
